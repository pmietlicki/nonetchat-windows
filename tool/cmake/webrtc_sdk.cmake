# Runs exclusively in our build-local copy, never in the shared pub cache.
if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  set(NONET_SDK_OS win)
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" NONET_SDK_PLATFORM)
  if(NONET_SDK_PLATFORM STREQUAL "arm64")
    set(NONET_SDK_ARCH arm64)
  elseif((NONET_SDK_PLATFORM STREQUAL "x64" OR NONET_SDK_PLATFORM STREQUAL "")
      AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(NONET_SDK_ARCH x64)
  else()
    message(FATAL_ERROR "Unsupported local WebRTC Windows architecture")
  endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(NONET_SDK_OS linux)
  if(FLUTTER_TARGET_PLATFORM MATCHES "arm64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(NONET_SDK_ARCH arm64)
  elseif(FLUTTER_TARGET_PLATFORM MATCHES "x64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(NONET_SDK_ARCH x64)
  else()
    message(FATAL_ERROR "Unsupported local WebRTC Linux architecture")
  endif()
else()
  message(FATAL_ERROR "Unsupported local WebRTC SDK platform")
endif()

if(NONET_SDK_OS STREQUAL "linux")
  if(NOT NONET_LINUX_SCOPE_ROOT)
    message(FATAL_ERROR "The Linux WebRTC source scope is required")
  endif()
  include("${NONET_LINUX_SCOPE_ROOT}/tool/cmake/webrtc_linux_sdk.cmake")
  return()
endif()

set(NONET_SDK_SHA "${NONET_WEBRTC_SDK_SHA_${NONET_SDK_OS}_${NONET_SDK_ARCH}}")
string(LENGTH "${NONET_SDK_SHA}" NONET_SDK_SHA_LENGTH)
if(NOT NONET_SDK_SHA_LENGTH EQUAL 64 OR NOT NONET_SDK_SHA MATCHES "^[a-f0-9]+$")
  message(FATAL_ERROR "A pinned WebRTC SDK digest is required")
endif()
set(NONET_SDK_ASSET "libwebrtc-${NONET_SDK_OS}-${NONET_SDK_ARCH}-release.zip")
set(NONET_SDK_ARCHIVE "${CMAKE_CURRENT_LIST_DIR}/downloads/${NONET_SDK_ASSET}")
set(NONET_SDK_DIR "${CMAKE_CURRENT_LIST_DIR}/libwebrtc")
set(NONET_SDK_URL
  "https://github.com/webrtc-sdk/libwebrtc/releases/download/${NONET_WEBRTC_SDK_VERSION}/${NONET_SDK_ASSET}")
if(NOT EXISTS "${NONET_SDK_ARCHIVE}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/downloads")
  file(DOWNLOAD "${NONET_SDK_URL}" "${NONET_SDK_ARCHIVE}"
    TLS_VERIFY ON EXPECTED_HASH "SHA256=${NONET_SDK_SHA}" STATUS NONET_DOWNLOAD)
  list(GET NONET_DOWNLOAD 0 NONET_DOWNLOAD_CODE)
  if(NOT NONET_DOWNLOAD_CODE EQUAL 0)
    message(FATAL_ERROR "Verified WebRTC SDK download failed")
  endif()
endif()
file(SHA256 "${NONET_SDK_ARCHIVE}" NONET_DOWNLOADED_SHA)
if(NOT NONET_DOWNLOADED_SHA STREQUAL NONET_SDK_SHA)
  message(FATAL_ERROR "WebRTC SDK archive digest mismatch; remove only this build-local archive before retry")
endif()

set(NONET_SDK_STAMP "${CMAKE_CURRENT_LIST_DIR}/installed-sdk.sha256")
set(NONET_INSTALLED_SHA "")
if(EXISTS "${NONET_SDK_STAMP}")
  file(READ "${NONET_SDK_STAMP}" NONET_INSTALLED_SHA)
endif()
if(NOT NONET_INSTALLED_SHA STREQUAL NONET_SDK_SHA
    OR NOT EXISTS "${NONET_SDK_DIR}/include/libwebrtc.h")
  set(NONET_SDK_STAGE "${CMAKE_CURRENT_LIST_DIR}/.nonet_sdk_extract")
  file(REMOVE_RECURSE "${NONET_SDK_STAGE}")
  file(MAKE_DIRECTORY "${NONET_SDK_STAGE}")
  file(ARCHIVE_EXTRACT INPUT "${NONET_SDK_ARCHIVE}" DESTINATION "${NONET_SDK_STAGE}")
  file(GLOB NONET_SDK_ROOTS "${NONET_SDK_STAGE}/*")
  list(LENGTH NONET_SDK_ROOTS NONET_SDK_ROOT_COUNT)
  if(NOT NONET_SDK_ROOT_COUNT EQUAL 1)
    message(FATAL_ERROR "Review WebRTC SDK archive layout")
  endif()
  list(GET NONET_SDK_ROOTS 0 NONET_SDK_ROOT)
  if(NOT IS_DIRECTORY "${NONET_SDK_ROOT}"
      OR NOT EXISTS "${NONET_SDK_ROOT}/include/libwebrtc.h"
      OR NOT IS_DIRECTORY "${NONET_SDK_ROOT}/lib")
    message(FATAL_ERROR "WebRTC SDK headers/libraries missing")
  endif()
  file(REMOVE_RECURSE "${NONET_SDK_DIR}")
  file(RENAME "${NONET_SDK_ROOT}" "${NONET_SDK_DIR}")
  file(REMOVE_RECURSE "${NONET_SDK_STAGE}")
  file(WRITE "${NONET_SDK_STAMP}" "${NONET_SDK_SHA}")
endif()
if(NONET_SDK_OS STREQUAL "win")
  if(NOT EXISTS "${NONET_SDK_DIR}/lib/libwebrtc.dll"
      OR NOT EXISTS "${NONET_SDK_DIR}/lib/libwebrtc.dll.lib")
    message(FATAL_ERROR "WebRTC Windows SDK libraries missing")
  endif()
elseif(NOT EXISTS "${NONET_SDK_DIR}/lib/libwebrtc.so")
  message(FATAL_ERROR "WebRTC Linux SDK library missing")
endif()
